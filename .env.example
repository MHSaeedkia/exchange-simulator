# exchange-simulator — every setting the tool reads. Copy to .env and edit.
# Real environment variables always win over this file, so a one-off change needs
# no edit:  OKX_RECORDS=500 go run .
# Every value below is also the built-in default.

# --- Output ------------------------------------------------------------------------
# websocket = fake exchange servers on the REAL host names, ports and paths. NiFi
#             reaches them once the host names point here (docs/REDIRECT.md).
#             Markets come from the subscribe messages (lpa-console → NiFi).
# kafka     = write straight to each exchange's raw topic, NiFi is not used.
#             Markets come from the database (see below).
OUTPUT_MODE=websocket

# Exchanges that send data from the start, comma separated ("none" = all stopped).
# Start and stop the others at runtime: POST /exchanges/{name}/start | stop.
# A stopped exchange is silent: it keeps connections and answers subscribe/ping,
# but sends no market data.
EXCHANGES_RUNNING=okx

# --- websocket mode -----------------------------------------------------------------
# One listener per port of all exchanges (443, 8443, …); a request goes to the
# exchange that owns its host name + path.
LISTEN_HOST=0.0.0.0
# TLS with a certificate for every exchange host name, signed by our own test CA.
# The CA is made once (keep certs/ on a volume) and must be in NiFi's truststore;
# the server certificate is made again on every start. false = plain ws:// http://.
TLS_ENABLED=true
TLS_CA_CERT=certs/ca.crt
TLS_CA_KEY=certs/ca.key
TLS_CERT=certs/server.crt
TLS_KEY=certs/server.key
# An HTTP proxy for NiFi's proxied calls (okx WS + REST, lbank, bybit REST): their
# real proxy looks the host name up itself, so the DNS aliases do not catch them.
# For a test, set NiFi's proxy_server.host parameter to this container; the port is
# the same as the real proxy's, so it stays. A call for a host the simulator does
# not play is refused. 0 = no proxy.
PROXY_PORT=2053
# Frames queued per connection. When the queue is full the generator waits, and
# what it could not send on time is counted as "missed".
WS_SEND_BUFFER=10000
# A connection that cannot take a frame in this time is closed.
WS_WRITE_TIMEOUT_MS=10000

# --- kafka mode ----------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092
# Each exchange's raw topic; {id} becomes its exchange id. The tool never creates
# topics (only warmup and lpa-console do).
KAFKA_TOPIC=ex{id}-raw
# The "simulation" value written with each frame (NiFi writes 0 for live data).
SIMULATION=1
# Markets to send = exchange_markets rows of the exchange whose status is
# MARKET_STATUS, re-read every DB_REFRESH_MS.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/markets?sslmode=disable
MARKET_STATUS=subscribe
DB_REFRESH_MS=5000

# How often each generator checks what is due. 1 ms spreads the frames evenly.
TICK_MS=1

# --- okx (exchange 8) -----------------------------------------------------------------
# Every exchange has a block like this one, under its name as prefix.
OKX_ID=8
# The REAL addresses: NiFi dials these, the redirect sends them here.
OKX_WS_HOST=ws.okx.com
OKX_WS_PORT=8443
OKX_WS_PATH=/ws/v5/public
OKX_REST_HOST=www.okx.com
OKX_REST_PORT=443
OKX_REST_PATH=/api/v5/market/books
# The first stage: OKX_RECORDS update frames every OKX_PERIOD_MS milliseconds, in
# total for all its markets (0 = paused). Change at runtime:
#   POST /exchanges/okx/settings {"records":500,"period_ms":100}
OKX_RECORDS=100
OKX_PERIOD_MS=1000
# Levels per side in a snapshot (real okx sends 400) and in each update.
OKX_BOOK_DEPTH=400
OKX_UPDATE_LEVELS=5
# The book: asks from BASE_PRICE up, bids from one step below it down. BOOK_DEPTH ×
# PRICE_STEP must stay below BASE_PRICE so the lowest bid is above 0. Quantities are
# random between QTY_MIN and QTY_MAX; their number of decimals is kept.
OKX_BASE_PRICE=62770
OKX_PRICE_STEP=0.1
OKX_QTY_MIN=0.00100000
OKX_QTY_MAX=5.00000000
# seqId of a new book, and the random step between two frames (real okx steps by
# 3…960, not by 1).
OKX_SEQ_START=1000000000
OKX_SEQ_STEP_MIN=1
OKX_SEQ_STEP_MAX=100

# --- nobitex (exchange 1) -------------------------------------------------------------
# Centrifugo WebSocket only (NiFi makes no REST call for nobitex). Every push is the
# WHOLE book; UPDATE_LEVELS is how many levels per side change between two pushes. A
# subscribe gets an ack and no snapshot, as on real nobitex. The server pings each
# connection with {} every 25 s.
NOBITEX_ID=1
NOBITEX_WS_HOST=ws.nobitex.ir
NOBITEX_WS_PORT=443
NOBITEX_WS_PATH=/connection/websocket
NOBITEX_RECORDS=100
NOBITEX_PERIOD_MS=1000
NOBITEX_BOOK_DEPTH=24
NOBITEX_UPDATE_LEVELS=5
NOBITEX_BASE_PRICE=84000
NOBITEX_PRICE_STEP=0.01
NOBITEX_QTY_MIN=0.000001
NOBITEX_QTY_MAX=0.200000
# The offset of a new book. It always moves by one per push (no step setting).
NOBITEX_SEQ_START=100000

# --- bitpin (exchange 2) --------------------------------------------------------------
# Centrifugo WebSocket only (NiFi makes no REST call for bitpin), the same protocol as
# nobitex: every push is the WHOLE book, no snapshot on subscribe, {} ping every 25 s.
# Markets are written with an underscore: BTC_USDT.
BITPIN_ID=2
BITPIN_WS_HOST=centrifugo.bitpin.ir
BITPIN_WS_PORT=443
BITPIN_WS_PATH=/connection/websocket
BITPIN_RECORDS=100
BITPIN_PERIOD_MS=1000
BITPIN_BOOK_DEPTH=50
BITPIN_UPDATE_LEVELS=5
BITPIN_BASE_PRICE=84000
BITPIN_PRICE_STEP=0.01
BITPIN_QTY_MIN=0.00000001
BITPIN_QTY_MAX=0.20000000
# The offset of a new book. It always moves by one per push (no step setting).
BITPIN_SEQ_START=3000000

# --- wallex (exchange 3) --------------------------------------------------------------
# WebSocket only (NiFi makes no REST call for wallex). A market is TWO channels:
# BTCUSDT@buyDepth (bids) and BTCUSDT@sellDepth (asks). Each frame is one channel's
# whole side, so RECORDS counts channel frames, and BOOK_DEPTH is the levels of a side.
# As real wallex: it speaks first, never answers subscribe/unsubscribe, takes only 51
# subscribe requests per connection (later ones are ignored), pings every 20 s, closes
# a connection after 30 s without a pong, and closes EVERY connection at 30 minutes.
WALLEX_ID=3
WALLEX_WS_HOST=api.wallex.ir
WALLEX_WS_PORT=443
WALLEX_WS_PATH=/ws
WALLEX_RECORDS=100
WALLEX_PERIOD_MS=1000
WALLEX_BOOK_DEPTH=50
WALLEX_UPDATE_LEVELS=5
WALLEX_BASE_PRICE=84000
WALLEX_PRICE_STEP=0.01
WALLEX_QTY_MIN=0.00000001
WALLEX_QTY_MAX=0.20000000

# --- ramzinex (exchange 4) ------------------------------------------------------------
# Centrifugo WebSocket, as nobitex but: markets are numeric ids (12), the connect reply has
# no version, any channel namespace is acked, and a ping must be answered within 10 s.
# Every push is the WHOLE book, both sides price-descending. The REST order book answers
# NiFi's snapshot branch at REST_PATH + {market}/buys_sells (lpa-core never asks today).
RAMZINEX_ID=4
RAMZINEX_WS_HOST=websocket.ramzinex.com
RAMZINEX_WS_PORT=443
RAMZINEX_WS_PATH=/websocket
RAMZINEX_REST_HOST=publicapi.ramzinex.com
RAMZINEX_REST_PORT=443
RAMZINEX_REST_PATH=/exchange/api/v1.0/exchange/orderbooks/
RAMZINEX_RECORDS=100
RAMZINEX_PERIOD_MS=1000
RAMZINEX_BOOK_DEPTH=50
RAMZINEX_UPDATE_LEVELS=5
RAMZINEX_BASE_PRICE=84000
RAMZINEX_PRICE_STEP=0.01
RAMZINEX_QTY_MIN=0.0000010
RAMZINEX_QTY_MAX=0.0200000
# The offset of a new book. It always moves by one per push (no step setting).
RAMZINEX_SEQ_START=1900000

# --- bitget (exchange 5) --------------------------------------------------------------
# The books50 channel: every frame is the WHOLE book (no extra snapshot on subscribe).
# As real bitget: a client that sends no "ping" for 2 minutes is dropped with no close
# frame. NiFi never pings, so its bitget connection is cut about every 2 minutes and it
# reconnects — exactly as on the real exchange.
BITGET_ID=5
BITGET_WS_HOST=ws.bitget.com
BITGET_WS_PORT=443
BITGET_WS_PATH=/v2/ws/public
BITGET_RECORDS=100
BITGET_PERIOD_MS=1000
BITGET_BOOK_DEPTH=50
BITGET_UPDATE_LEVELS=5
BITGET_BASE_PRICE=84000
BITGET_PRICE_STEP=0.01
BITGET_QTY_MIN=0.000001
BITGET_QTY_MAX=0.600000
# seq of a new book and the random step between frames (real bitget: 2816…11122 seen).
BITGET_SEQ_START=941000000000
BITGET_SEQ_STEP_MIN=2000
BITGET_SEQ_STEP_MAX=12000

# --- bybit (exchange 6) ---------------------------------------------------------------
# orderbook.50: an ack, then a snapshot, then deltas of the changed levels (u moves by
# exactly one). The REST order book answers NiFi's snapshot branch, which NiFi calls
# through its proxy: in a test that is the simulator's proxy (PROXY_PORT).
BYBIT_ID=6
BYBIT_WS_HOST=stream.bybit.com
BYBIT_WS_PORT=443
BYBIT_WS_PATH=/v5/public/spot
BYBIT_REST_HOST=api.bybit.com
BYBIT_REST_PORT=443
BYBIT_REST_PATH=/v5/market/orderbook
BYBIT_RECORDS=100
BYBIT_PERIOD_MS=1000
BYBIT_BOOK_DEPTH=50
BYBIT_UPDATE_LEVELS=5
BYBIT_BASE_PRICE=84000
BYBIT_PRICE_STEP=0.1
BYBIT_QTY_MIN=0.000001
BYBIT_QTY_MAX=0.900000
# u of a new book. It always moves by one per delta (no step setting).
BYBIT_SEQ_START=346400000

# --- Control API ----------------------------------------------------------------------
# GET /status, POST /exchanges/{name}/start|stop|settings, POST /stop. Port 0 = random.
API_ADDR=0.0.0.0:9501

# --- Monitoring (one report row per stage) ------------------------------------------
# Empty = no Prometheus numbers. Each line of the queries file is `name: promql`.
PROMETHEUS_URL=
PROM_QUERIES_FILE=queries.example.txt
# Docker Engine API. The tool must run on the host of these containers.
# On Docker Desktop for Mac the socket may be unix:///Users/<you>/.docker/run/docker.sock
DOCKER_HOST=unix:///var/run/docker.sock
# Container names, comma separated; "none" = no Docker numbers. The taskmanagers
# have no fixed name: see `docker ps` (e.g. lpa-core-taskmanager-1).
MONITOR_CONTAINERS=nifi,kafka,jobmanager
SAMPLE_INTERVAL_MS=5000
# Each run writes to its own folder inside this one.
REPORT_DIR=reports
